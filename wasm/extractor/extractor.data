    code:
      - '#include "sf64mesg.h"'
      - ''
      - '// clang-format off'
      - 'typedef enum {'
      - '    END, NWL, NP2, NP3, NP4, NP5, NP6, NP7,'
      - '    PRI0, PRI1, PRI2, PRI3, SPC, HSP, QSP, NXT,'
